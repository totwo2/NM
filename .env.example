# N.M 环境配置示例
# 复制为 .env 或直接 export（Docker 用 -e 传入）
#
# 注意: 本文件仅示例，不含真实密钥。请勿提交真实 API Key。

# ===== Web 服务 =====
NM_PORT=8787

# ===== 模型（OpenAI 兼容）=====
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# NM_MODEL=gpt-4o-mini

# ===== Agent 循环 =====
# NM_MAX_TURNS=50
# NM_STREAM=true

# ===== 记忆 =====
# NM_MEMORY_TTL_DAYS=30

# ===== 安全 =====
# 演示模式允许空密码（生产环境务必保持 0）
# NM_ALLOW_EMPTY_PASSWORD=0